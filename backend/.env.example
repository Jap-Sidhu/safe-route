# Copy to backend/.env and fill in. Never commit the real .env.

# NASA FIRMS map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenRouteService key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# OpenWeather key: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Redis connection, e.g. Upstash: rediss://default:<password>@<host>:6379
# Leave empty locally to use an in-memory cache.
REDIS_URL=

# Optional tuning (defaults shown)
# REFRESH_INTERVAL_SECONDS=600
# CACHE_TTL_SECONDS=1800
# REFRESH_LOCK_SECONDS=120
# FIRMS_DAYS=2
# FIRMS_MIN_FRP=0
# USGS_DAYS=30
